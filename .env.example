# Copy to .env, then paste your own DeepSeek API key into OPENAI_API_KEY.
# The Go backend uses OPENAI_* for any OpenAI-compatible provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
OPENAI_VISION_MODEL=deepseek-flash
OPENAI_MAX_TOKENS=8192

# Local-only API on 127.0.0.1:3001; Next.js runs on localhost:3000.
OFFERPILOT_API_BIND=127.0.0.1
PORT=3001
OFFERPILOT_ALLOWED_ORIGINS=http://localhost:3000
OFFERPILOT_REQUIRE_AUTH=false
OFFERPILOT_API_KEY=
KNOWLEDGE_DIR=knowledge
DB_PATH=data/offerpilot.db

# Optional speech provider. Leave empty if you only need text features.
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_ASR_MODEL=mimo-v2.5-asr
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=mimo_default

# Optional context tuning. 0 means the model window is not assumed.
OFFERPILOT_CONTEXT_WINDOW=0
OFFERPILOT_CONTEXT_INPUT_CAP=30000
OFFERPILOT_CONTEXT_SAFETY=1024
OFFERPILOT_SUMMARY_MAX_TOKENS=8192
OFFERPILOT_SUMMARY_DISABLE_THINKING=true

